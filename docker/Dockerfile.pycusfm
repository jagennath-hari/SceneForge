# syntax=docker/dockerfile:1
ARG BASE_FROM=stereoforge/stereo:latest
FROM ${BASE_FROM} AS pycusfm

# The pinned upstream ships x86 CUDA binaries, not ARM binaries.
ARG TARGETARCH
RUN test "${TARGETARCH}" = amd64
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        libopencv-dev libgoogle-glog-dev libgflags-dev libabsl-dev \
        libprotobuf-dev protobuf-compiler

COPY third_party/pycusfm/ /opt/third_party/pycusfm/
WORKDIR /opt/third_party/pycusfm
# Correct the CUDA-12-only dependency in the IMAGE copy of upstream metadata.
# Editable installation preserves the selected binary/library symlinks and assets.
# PIP_CONSTRAINT pins TensorRT to 10.13.3.9, matching upstream's 25.09 container.
RUN bash setup.bash cuda13 && \
    sed -i 's/tensorrt-cu12>=10.3.0.26/tensorrt-cu13>=10.13,<11/' pyproject.toml
# TensorRT 10.13.3.9 references the retired nvidia-cuda-runtime-cu13 package.
# CUDA is supplied by our base image. Install all three TensorRT components
# explicitly, without resolving that obsolete runtime dependency. Keep build
# isolation enabled so NVIDIA's wheel-stub build backend can be installed.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps \
        tensorrt-cu13==10.13.3.9 \
        tensorrt-cu13-bindings==10.13.3.9 \
        tensorrt-cu13-libs==10.13.3.9 && \
    python -m pip install --no-deps -e /opt/third_party/pycusfm
# pyCuSFM's other dependencies (NumPy, setuptools, PyYAML, Pillow) are already
# installed by the preceding images. Do not re-resolve TensorRT's runtime stub.

# Expose the pip-installed TensorRT 10 libraries to native cuSFM executables.
# TensorRT is installed by pip above; the CUDA/cuDNN base does not supply it.
RUN python - <<'PY'
from pathlib import Path
import site

library = next(
    library
    for directory in site.getsitepackages()
    for library in Path(directory).rglob('libnvinfer.so.10')
)
Path('/opt/tensorrt').mkdir(exist_ok=True)
Path('/opt/tensorrt/lib').symlink_to(library.parent)
PY
ENV TRT_LIB_PATH=/opt/tensorrt/lib \
    LD_LIBRARY_PATH=/opt/tensorrt/lib:${LD_LIBRARY_PATH}
WORKDIR /workspace/StereoForge


ARG USER_UID=1000
ARG USER_GID=1000

# Ubuntu images can already have a user at UID 1000. Reuse that UID safely.
RUN if ! getent group "${USER_GID}" >/dev/null; then \
        groupadd --gid "${USER_GID}" stereoforge; \
    fi && \
    if getent passwd "${USER_UID}" >/dev/null; then \
        existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
        usermod --gid "${USER_GID}" --home /home/stereoforge \
            --shell /bin/bash "${existing_user}"; \
    else \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" \
            --home-dir /home/stereoforge --shell /bin/bash stereoforge; \
    fi && \
    mkdir -p /home/stereoforge/.cache /workspace/StereoForge/data \
        /workspace/StereoForge/weights && \
    chown -R "${USER_UID}:${USER_GID}" /home/stereoforge /workspace/StereoForge

# Include source defaults so the image also contains the project without mounts.
COPY --chown=${USER_UID}:${USER_GID} stereoforge/ /workspace/StereoForge/stereoforge/
COPY --chown=${USER_UID}:${USER_GID} configs/ /workspace/StereoForge/configs/
ENV HOME=/home/stereoforge \
    XDG_CACHE_HOME=/home/stereoforge/.cache \
    HF_HOME=/home/stereoforge/.cache/huggingface \
    TORCH_HOME=/home/stereoforge/.cache/torch

USER ${USER_UID}:${USER_GID}
WORKDIR /workspace/StereoForge
CMD ["/bin/bash"]
