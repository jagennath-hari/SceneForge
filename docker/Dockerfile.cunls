ARG BASE_FROM=sceneforge/geometry:latest
FROM ${BASE_FROM} AS cunls

# Build the checked-out submodule against the same CUDA toolkit as SceneForge.
# No edits to upstream source, GPU access, examples, or tests are required here.
COPY third_party/cuNLS/ /opt/third_party/cuNLS/
RUN cmake -S /opt/third_party/cuNLS -B /tmp/cunls-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/cunls \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PYTHON_BINDINGS=OFF \
        -DBUILD_TESTING=OFF && \
    cmake --build /tmp/cunls-build --parallel "$(nproc)" && \
    cmake --install /tmp/cunls-build && \
    cp -a /tmp/cunls-build/_deps/cudss-src /opt/cudss && \
    rm -rf /tmp/cunls-build

# cuNLS loads cuDSS with dlopen; expose both native libraries to future callers.
ENV CMAKE_PREFIX_PATH=/opt/cunls \
    LD_LIBRARY_PATH=/opt/cunls/lib:/opt/cudss/lib:${LD_LIBRARY_PATH}

# Native in-process map builder dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends libeigen3-dev python3-dev && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/uv uv pip install 'pybind11>=2.13,<3'

# SceneForge factors and native solver; upstream cuNLS remains unchanged.
COPY sceneforge/optimization/ /opt/sceneforge/optimization/
RUN cmake -S /opt/sceneforge/optimization -B /tmp/sceneforge-optimization -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DPython_EXECUTABLE=/opt/sceneforge-venv/bin/python && \
    cmake --build /tmp/sceneforge-optimization --parallel "$(nproc)" && \
    cmake --install /tmp/sceneforge-optimization && \
    rm -rf /tmp/sceneforge-optimization

ARG USERNAME=appuser
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

RUN apt-get update && apt-get install -y --no-install-recommends sudo && rm -rf /var/lib/apt/lists/*

# Reuse Ubuntu's existing numeric identity, but give it the host's login name.
RUN set -eu; \
    if getent group "${USER_GID}" >/dev/null; then \
        existing_group="$(getent group "${USER_GID}" | cut -d: -f1)"; \
        if [ "${existing_group}" != "${USERNAME}" ]; then \
            groupmod --new-name "${USERNAME}" "${existing_group}"; \
        fi; \
    else \
        groupadd --gid "${USER_GID}" "${USERNAME}"; \
    fi; \
    if getent passwd "${USER_UID}" >/dev/null; then \
        existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1)"; \
        if [ "${existing_user}" != "${USERNAME}" ]; then \
            usermod --login "${USERNAME}" "${existing_user}"; \
        fi; \
        usermod --gid "${USER_GID}" --home "/home/${USERNAME}" \
            --move-home --shell /bin/bash "${USERNAME}"; \
    else \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home \
            --home-dir "/home/${USERNAME}" --shell /bin/bash "${USERNAME}"; \
    fi; \
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "${USERNAME}" > /etc/sudoers.d/sceneforge; \
    chmod 0440 /etc/sudoers.d/sceneforge; \
    mkdir -p "/home/${USERNAME}/.cache" /workspace/SceneForge/data; \
    chown -R "${USER_UID}:${USER_GID}" "/home/${USERNAME}" /workspace/SceneForge

# Include source defaults so the image also contains the project without mounts.
COPY --chown=${USER_UID}:${USER_GID} sceneforge/ /workspace/SceneForge/sceneforge/
COPY --chown=${USER_UID}:${USER_GID} configs/ /workspace/SceneForge/configs/
ENV HOME=/home/${USERNAME} \
    XDG_CACHE_HOME=/home/${USERNAME}/.cache \
    HF_HOME=/home/${USERNAME}/.cache/huggingface \
    TORCH_HOME=/home/${USERNAME}/.cache/torch
