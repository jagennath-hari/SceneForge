# syntax=docker/dockerfile:1
ARG BASE_FROM=sceneforge/base:latest
FROM ${BASE_FROM} AS geometry

# TensorRT 10.13.3.9 references the retired nvidia-cuda-runtime-cu13 package.
# CUDA is supplied by our base image. Install all three TensorRT components
# explicitly, without resolving that obsolete runtime dependency. Keep build
# isolation enabled so NVIDIA's wheel-stub build backend can be installed.
# Retain the working pip installer for these legacy TensorRT packages only.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps \
        tensorrt-cu13==10.13.3.9 \
        tensorrt-cu13-bindings==10.13.3.9 \
        tensorrt-cu13-libs==10.13.3.9
# Expose the pip-installed TensorRT 10 libraries to native feature inference.
# TensorRT is installed by pip above; the CUDA/cuDNN base does not supply it.
RUN python - <<'PY'
from pathlib import Path
import site

library = next(
    library
    for directory in site.getsitepackages()
    for library in Path(directory).rglob('libnvinfer.so.10')
)
Path('/opt/tensorrt').mkdir(exist_ok=True)
Path('/opt/tensorrt/lib').symlink_to(library.parent)
PY
ENV TRT_LIB_PATH=/opt/tensorrt/lib \
    LD_LIBRARY_PATH=/opt/tensorrt/lib:${LD_LIBRARY_PATH}
# Matching public headers; do not replace the pinned TensorRT runtime libraries.
RUN git init /tmp/tensorrt-headers && \
    git -C /tmp/tensorrt-headers remote add origin https://github.com/NVIDIA/TensorRT.git && \
    git -C /tmp/tensorrt-headers fetch --depth 1 origin b8db91e15be2cae4465ac17fab19e0f969e45407 && \
    git -C /tmp/tensorrt-headers checkout --detach FETCH_HEAD && \
    cp -r /tmp/tensorrt-headers/include /opt/tensorrt/include && rm -rf /tmp/tensorrt-headers
# The repository gitlink pins the exact upstream implementation used by export.
COPY third_party/lightglue-onnx/ /opt/third_party/lightglue-onnx/
ENV PYTHONPATH=/workspace/SceneForge:/opt/third_party/lightglue-onnx
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install 'onnx>=1.17,<2' 'onnxscript>=0.3,<1'

COPY sceneforge/video/ /opt/sceneforge/video/
RUN cmake -S /opt/sceneforge/video -B /opt/sceneforge/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /opt/sceneforge/build --parallel "$(nproc)" && \
    cmake --install /opt/sceneforge/build && \
    rm -rf /opt/sceneforge/build

COPY third_party/vggt-omega/requirements.txt /opt/requirements/vggt-omega.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r /opt/requirements/vggt-omega.txt huggingface-hub
COPY third_party/vggt-omega/ /opt/third_party/vggt-omega/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-build-isolation --no-deps /opt/third_party/vggt-omega

# Pinned local Hub implementation; inference weights download into the runtime cache.
# Upstream imports faiss in its aggregation module, even when using GeM only.
COPY third_party/SelaVPRplusplus/hubconf.py /opt/third_party/SelaVPRplusplus/hubconf.py
COPY third_party/SelaVPRplusplus/model/ /opt/third_party/SelaVPRplusplus/model/
ENV SELAVPR_ROOT=/opt/third_party/SelaVPRplusplus
RUN --mount=type=cache,target=/root/.cache/uv uv pip install 'faiss-cpu==1.8.0.post1'

# v0.0.34 retains the xformers.ops API used by SelaVPR++'s DINOv2.
# Build CUTLASS attention (including FP32 retrieval) against our installed torch.
# Explicit architectures enable CUDA compilation without a GPU during docker build.
ARG XFORMERS_COMMIT=3da0fc922521aaecebc35e3938b5110bd5cb7195
ARG XFORMERS_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0+PTX"
RUN --mount=type=cache,target=/root/.cache/uv \
    git init /tmp/xformers && \
    git -C /tmp/xformers remote add origin https://github.com/facebookresearch/xformers.git && \
    git -C /tmp/xformers fetch --depth 1 origin "${XFORMERS_COMMIT}" && \
    git -C /tmp/xformers checkout --detach FETCH_HEAD && \
    git -C /tmp/xformers submodule update --init --recursive --depth 1 \
        --jobs "$(nproc)" -- third_party/cutlass && \
    MAX_JOBS="$(nproc)" \
    TORCH_CUDA_ARCH_LIST="${XFORMERS_CUDA_ARCH_LIST}" \
    FORCE_CUDA=1 XFORMERS_BUILD_TYPE=Release \
    XFORMERS_PT_CUTLASS_ATTN=0 XFORMERS_DISABLE_FLASH_ATTN=1 \
        uv pip install --verbose --no-build-isolation --no-deps /tmp/xformers && \
    rm -rf /tmp/xformers
