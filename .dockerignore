# Only image definitions, pinned upstream sources and application source enter.
**
!docker/
!docker/**
!third_party/
!third_party/vggt-omega/
!third_party/vggt-omega/**
!third_party/cuNLS/
!third_party/cuNLS/**
!third_party/lightglue-onnx/
!third_party/lightglue-onnx/**
!third_party/SelaVPRplusplus/
!third_party/SelaVPRplusplus/hubconf.py
!third_party/SelaVPRplusplus/model/
!third_party/SelaVPRplusplus/model/**
!sceneforge/
!sceneforge/**
!configs/
!configs/**
sceneforge/**/build/
**/.git
**/.git/**
**/__pycache__
**/*.pyc
**/.cache
**/.venv
**/.secrets
**/.secrets/**
# Ignore local cuNLS build products; Docker compiles the checked-out source.
third_party/cuNLS/build*/
third_party/cuNLS/python/build/
third_party/cuNLS/dist/

third_party/lightglue-onnx/weights/

# Rust build artifacts stay out of the build context.
sceneforge/**/target/

# Only the runtime entrypoint is needed from the host scripts directory.
!scripts/
!scripts/entrypoint.sh
