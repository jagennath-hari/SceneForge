# syntax=docker/dockerfile:1
ARG BASE_FROM=nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04
FROM ${BASE_FROM} AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv build-essential ca-certificates \
        cmake ffmpeg git libgl1 libglib2.0-0 ninja-build pkg-config

RUN python3 -m venv /opt/stereoforge-venv
ENV VIRTUAL_ENV=/opt/stereoforge-venv \
    PATH=/opt/stereoforge-venv/bin:${PATH} \
    PIP_CONSTRAINT=/opt/stereoforge/constraints.txt
COPY docker/constraints.txt /opt/stereoforge/constraints.txt
# Install PyTorch explicitly on top of CUDA/cuDNN; this base has no framework.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install torch torchvision \
        --index-url https://download.pytorch.org/whl/cu132 && \
    python -m pip install av PyYAML

WORKDIR /workspace/StereoForge
